PORT=5000
NODE_ENV=development

# ========== NSE/Indian Stock Data API (Primary Source) ==========
# Upstox API - Free real-time Indian stock data
# Get key from: https://upstox.com/api/
UPSTOX_API_KEY=your_upstox_api_key_here

# RapidAPI Fallback (Optional alternative data source)
# Get key from: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=stock-market-data.p.rapidapi.com

# ========== Database Configuration ==========
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stock-tracker
DATABASE_URL=postgresql://user:password@localhost:5432/stockscreener

# ========== Authentication ==========
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# ========== Caching & Real-time ==========
REDIS_URL=redis://localhost:6379
WS_PORT=5001

# ========== Frontend ==========
FRONTEND_URL=http://localhost:3000

# ========== Email Alerts (Optional) ==========
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ========== Rate Limiting ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========== Free Platform Deployment ==========
# RENDER_SERVICE_URL=your_render_url
# VERCEL_PROJECT_URL=your_vercel_url
