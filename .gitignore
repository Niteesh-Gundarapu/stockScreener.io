# Root gitignore for full Stock Intelligence project

# Node modules
node_modules/
**/node_modules/

# Environment variables
.env
*.env
backend/.env
frontend/.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory
coverage/
coverage-final.json

# Diagnostics
.DS_Store
Thumbs.db
 ehthumbs.db
Desktop.ini

# IDE/editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output
dist/
build/

# Vite cache
node_modules/.vite/
.vite/

# npm
package-lock.json
npm-debug.log*

# Optional npm cache directory
.npm

# yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# pnpm
.pnpm-debug.log

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*~

# Frontend build output
frontend/dist/
frontend/build/

# Backend build output
backend/dist/
backend/build/

# Misc
npm-shrinkwrap.json

# Package manager lock files if you prefer not to commit them
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
